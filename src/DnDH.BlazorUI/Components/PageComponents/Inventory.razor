<div class="col-lg-6">
	<section class="card mb-5">
		<div class="card-header">Inventory</div>
		<div class="card-body row g-3">
			<div class="col-md-6">
				<div>
					<label>Equipped</label>
					<textarea class="form-control" rows="5" @bind="Equipped" />
				</div>
				<div>
					<label>Gold</label>
					<input type="number" class="form-control" @bind="Gold" />
				</div>
			</div>
			<div class="col-md-6">
				<label>Backpack</label>
				<textarea class="form-control" rows="11" @bind="Backpack" />
			</div>
		</div>
		<div class="card-footer">
			<button class="btn btn-outline-success" @onclick="Save">💾 Save</button>
			<button class="btn btn-outline-danger" @onclick="LoadInventory">❌ Restore</button>
		</div>
	</section>
</div>

@code {
	[Parameter]
	public CharacterDTO? Character { get; set; }

	[Parameter]
	public EventCallback OnSave { get; set; }

	string Equipped = string.Empty;
	int Gold = 0;
	string Backpack = string.Empty;

	void LoadInventory()
	{
		if (Character is not null)
		{
			var inventory = Character.Inventory;
			Equipped = string.Join(Environment.NewLine, inventory.EquippedItems);
			Gold = inventory.Gold;
			Backpack = string.Join(Environment.NewLine, inventory.OtherItems);
		}
	}

	protected override void OnParametersSet()
	{
		base.OnParametersSet();
		LoadInventory();
	}

	void Save()
	{
		Character?.Inventory = new InventoryDTO
		{
			EquippedItems = Equipped.Split(Environment.NewLine, StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList(),
			Gold = Gold,
			OtherItems = Backpack.Split(Environment.NewLine, StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList()
		};
		OnSave.InvokeAsync();
	}
}