@page "/campaigns"
@using DnDH.BlazorUI.Components.PageComponents

<MessageHandler errorMessage="@errorMessage" successMessage="@successMessage" />

<h1>Campaigns</h1>

@if (campaigns is null)
{
	<p><em>Loading data...</em></p>
} else if(!campaigns.Any())
{
	<p>List of available campaigns is empty</p>
} else
{
	<table class="table table-striped table-hover">
		<thead class="table-dark">
			<tr>
				<th class="col-md-3">Name</th>
				<th class="col-md-1"></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var campaign in campaigns)
			{
				<tr>
					<td>@campaign.Name</td>
					<td class="text-end">
						<button class="btn btn-outline-info" @onclick="() => ViewDetail(campaign.Id)">Detail</button>
						<button class="btn btn-outline-danger" @onclick="() => DeleteCampaign(campaign.Id)">🗑️</button>
					</td>
				</tr>
			}
			<tr>
				@if (addingNew)
				{
					<td><input class="form-control" @bind="newName"/></td>
					<td colspan="4">
						<button class="btn btn-outline-success" @onclick="SaveNewCampaign">💾</button>
						<button class="btn btn-outline-danger" @onclick="StopAddingNew">❌</button>
					</td>
				} else
				{
					<td colspan="5">
						<button class="btn btn-primary" @onclick="() => addingNew = true">Add new campaign</button>
					</td>
				}
			</tr>
		</tbody>
	</table>
}

@code {
	@inject ICampaignService CampaignService
	@inject NavigationManager NavigationManager

	IReadOnlyList<CampaignDTO>? campaigns;
	string? errorMessage;
	string? successMessage;
	
	bool addingNew = false;
	string newName = "";
	protected override void OnInitialized()
	{
		base.OnInitialized();
		LoadCampaigns();
	}

	void LoadCampaigns()
	{
		try
		{
			campaigns = CampaignService.GetAllAvailable();
		}
		catch (Exception ex)
		{
			errorMessage = ex.Message;
		}
	}
	void ViewDetail(int id) {
		NavigationManager.NavigateTo($"/campaigns/{id}");
	}

	void DeleteCampaign(int id)
	{
		try
		{
			CampaignService.Delete(id);
			successMessage = "Campaign deleted successfully.";
		}
		catch (Exception ex)
		{
			errorMessage = ex.Message;
		}
		LoadCampaigns();
	}

	void StopAddingNew()
	{
		addingNew = false;
		newName = "";
	}

	void SaveNewCampaign()
	{
		try 
		{
			CampaignService.Add(newName);
			successMessage = $"Campaign \"{newName}\" added successfully.";
		}
		catch (Exception ex)
		{
			errorMessage = ex.Message;
		}
		StopAddingNew();
		LoadCampaigns();
	}
}