@page "/characters"
@using DnDH.BlazorUI.Components.PageComponents

<MessageHandler errorMessage="@errorMessage" successMessage="@successMessage" />

<h1>Characters</h1>

@if (characters is null)
{
	<p><em>Loading data...</em></p>
} else if(!characters.Any())
{
	<p>List of available characters is empty</p>
} else
{
	<table class="table table-striped table-hover">
		<thead class="table-dark">
			<tr>
				<th class="col-md-2">Name</th>
				<th class="col-md-1">Level</th>
				<th class="col-md-1">Class</th>
				<th class="col-md-1">Race</th>
				<th class="col-md-1"></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var character in characters)
			{
				<tr>
					<td>@character.Name</td>
					<td>@character.Level</td>
					<td>@character.Class</td>
					<td>@character.Race</td>
					<td class="text-end">
						<button class="btn btn-outline-info" @onclick="() => ViewDetail(character.Id)">Detail</button>
						<button class="btn btn-outline-danger" @onclick="() => DeleteCharacter(character.Id)">🗑️</button>
					</td>
				</tr>
			}
			<tr>
				@if (addingNew)
				{
					<td><input class="form-control" @bind="newName"/></td>
					<td colspan="4">
						<button class="btn btn-outline-success" @onclick="SaveNewCharacter">💾</button>
						<button class="btn btn-outline-danger" @onclick="StopAddingNew">❌</button>
					</td>
				} else
				{
					<td colspan="5">
						<button class="btn btn-primary" @onclick="() => addingNew = true">Add new character</button>
					</td>
				}
			</tr>
		</tbody>
	</table>
}

@code {
	@inject ICharacterService CharacterService
	@inject NavigationManager NavigationManager

	IReadOnlyList<CharacterListItemDTO>? characters;
	string? errorMessage;
	string? successMessage;
	
	bool addingNew = false;
	string newName = "";
	protected override void OnInitialized()
	{
		base.OnInitialized();
		LoadCharacters();
	}

	void LoadCharacters()
	{
		try
		{
			characters = CharacterService.GetAllAvailable();
		}
		catch (Exception ex)
		{
			errorMessage = ex.Message;
		}
	}
	void ViewDetail(int id) {
		NavigationManager.NavigateTo($"/characters/{id}");
	}

	void DeleteCharacter(int id)
	{
		try
		{
			CharacterService.Delete(id);
			successMessage = "Character deleted successfully.";
		}
		catch (Exception ex)
		{
			errorMessage = ex.Message;
		}
		LoadCharacters();
	}

	void StopAddingNew()
	{
		addingNew = false;
		newName = "";
	}

	void SaveNewCharacter()
	{
		try 
		{
			CharacterService.Add(newName);
			successMessage = $"Character \"{newName}\" added successfully.";
		}
		catch (Exception ex)
		{
			errorMessage = ex.Message;
		}
		StopAddingNew();
		LoadCharacters();
	}
}